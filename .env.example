# ============================================
# TELEGRAM CONFIGURATION
# ============================================
TELEGRAM_BOT_TOKEN=your_telegram_bot_token_here

# ============================================
# MARKET DATA PROVIDERS CONFIGURATION
# ============================================
MARKET_DATA_PROVIDERS=binance
MARKET_TYPE=spot

# ============================================
# DATA AGGREGATOR CONFIGURATION
# ============================================
# ============================================
# TRIGGER ENGINE CONFIGURATION
# ============================================
# ============================================
# LOGGING CONFIGURATION
# ============================================
LOG_LEVEL=info
DEBUG=false
DEBUG_TRIGGER_ENGINE=false

# ============================================
# DATABASE CONFIGURATION
# ============================================
DATABASE_PATH=database.sqlite

# ============================================
# SUPABASE CONFIGURATION (Optional)
# ============================================
# SUPABASE_URL=https://your-project.supabase.co
# SUPABASE_API_KEY=your-supabase-anon-key

# ============================================
# SIGNAL ANALYZER CONFIGURATION
# ============================================
# Data source for analysis: 'memory' or 'supabase'
# - memory: Use in-memory data from live WebSocket feed
# - supabase: Fetch from Supabase database (requires SUPABASE_URL and SUPABASE_API_KEY)
SIGNAL_ANALYZER_DATA_SOURCE=supabase